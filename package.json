{
  "name": "puls-monorepo",
  "private": true,
  "description": "Monorepo for Puls intent-driven IaC",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @puls-dev/core && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@puls-dev/aws": "^1.0.0",
    "@puls-dev/azure": "^1.0.0",
    "@puls-dev/cloudflare": "^1.0.0",
    "@puls-dev/core": "^1.0.0",
    "@puls-dev/do": "^1.0.0",
    "@puls-dev/firebase": "^1.0.0",
    "@puls-dev/gcp": "^1.0.0",
    "@puls-dev/hcloud": "^1.0.0",
    "@puls-dev/proxmox": "^1.0.0"
  },
  "version": ""
}
