{
  "name": "@puls-dev/core",
  "version": "1.0.1",
  "description": "Core engine for Puls intent-driven IaC",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puls-dev/puls-dev.git",
    "directory": "packages/core"
  },
  "keywords": [
    "iac",
    "infrastructure-as-code",
    "puls",
    "devops",
    "cloud",
    "deploy"
  ],
  "bin": {
    "puls": "dist/bin/puls.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"const fs=require('fs'),f='dist/bin/puls.js';if(fs.existsSync(f)){const c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!'))fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c);fs.chmodSync(f, 0o755);}\"",
    "test": "find src -name '*.test.ts' | xargs tsx --test --test-concurrency=1"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2"
  },
  "optionalDependencies": {
    "vis-network": "^10.1.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
