{
  "name": "@puls-dev/aws",
  "version": "1.0.0",
  "description": "AWS Provider for Puls IaC",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puls-dev/puls-dev.git",
    "directory": "packages/aws"
  },
  "keywords": [
    "iac",
    "infrastructure-as-code",
    "puls",
    "aws",
    "cloud",
    "deploy"
